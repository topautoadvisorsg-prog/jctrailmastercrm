# 21 CRM / Twenty fork local placeholders.
# Do not put real secrets in this file.

NODE_ENV=development
SERVER_URL=http://localhost:3000
FRONT_BASE_URL=http://localhost:3001

# Twenty database placeholder.
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/default
PG_SSL_ALLOW_SELF_SIGNED=false

# Twenty auth/token placeholders.
ACCESS_TOKEN_SECRET=replace-with-local-secret
LOGIN_TOKEN_SECRET=replace-with-local-secret
REFRESH_TOKEN_SECRET=replace-with-local-secret
FILE_TOKEN_SECRET=replace-with-local-secret

# 21 CRM white-label config.
CUSTOMER_CONFIG_PATH=customer.config.json

# Provider placeholders. Leave blank until provider accounts are ready.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_LIVE_SENDS_APPROVED=false
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAP_API_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
ANTHROPIC_API_KEY=
MCP_SERVER_SECRET=

# Safe local defaults.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=21 CRM
STORAGE_TYPE=LOCAL
