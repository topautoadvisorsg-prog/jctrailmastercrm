{
  "framework": "vite",
  "installCommand": "corepack yarn install --immutable",
  "buildCommand": "corepack yarn workspace twenty-front build && node scripts/write-vercel-front-env.mjs",
  "outputDirectory": "packages/twenty-front/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
